{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Executar Backend (.NET)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Executar Frontend (Angular)",
      "command": "npm",
      "type": "shell",
      "args": [
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/produtos-front"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
